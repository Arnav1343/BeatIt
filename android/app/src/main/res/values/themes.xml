<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BeatIt" parent="android:Theme.Material.NoActionBar">
        <!-- The page's own base background colour. The window is painted with this before the
             WebView has anything to show, so the gap at startup reads as the
             app's own background rather than as a dead black screen. -->
        <item name="android:windowBackground">#0a0a0a</item>

        <!-- Edge to edge: the colour wash should run behind the status and
             navigation bars rather than stopping at a black band. The page
             keeps its content clear of them with env(safe-area-inset-*). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Draw into the camera cutout / punch-hole area too, so there is no
             letterbox on devices that have one. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- Light content on a dark wash. -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
